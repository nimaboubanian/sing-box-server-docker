# sing-box TLS (Trojan) inbound server env defaults. Copy to .env (gitignored) and fill in.
# The two REQUIRED vars have no defaults on purpose: the entrypoint exits with a
# FATAL line and the container restart-loops until they are set.
#
# Domain name for Let's Encrypt automated TLS certificates and Trojan SNI.
# If prefixed with www., the prefix is stripped to normalize to the root domain.
TLS_DOMAIN=

# Users are `name:password` pairs, comma-separated. Entries are split on the
# FIRST colon, so a password may contain colons — but not a comma or a newline,
# which the format cannot express. Names use letters, digits and _ @ + - only.
TLS_USERS=

# Optional email address for Let's Encrypt certificate expiration notifications.
TLS_EMAIL=

# Upstream router where authenticated proxy traffic is forwarded (defaults to vpndogs-router:1070)
CHAIN_SOCKS_HOST=vpndogs-router
CHAIN_SOCKS_PORT=1070

# Local inbound ports (defaults match standard deployments)
HTTPS_PORT=443
HTTP_PORT=80
SOCKS_PORT=1065
FALLBACK_PORT=8080
ACME_HTTP_PORT=8081

# ACME state directory
ACME_DIR=/var/lib/sing-box/acme
LOG_LEVEL=warn
